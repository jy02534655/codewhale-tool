{
  "name": "codewhale-tool",
  "version": "0.2.0",
  "private": true,
  "description": "CodeWhale AI 配置管理工具 — 多语言、可视化、实时同步",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "cli": "node packages/cli/src/index.js",
    "dev": "node scripts/dev.mjs",
    "server": "node packages/web/server.js",
    "build": "npm run --workspace=@codewhale/web build"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}